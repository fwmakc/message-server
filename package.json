{
  "name": "message-server",
  "version": "2.0.0",
  "description": "Message service — email sending, notifications, event-driven messaging",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "github:fwmakc/message-server"
  },
  "keywords": [
    "nestjs",
    "email",
    "smtp",
    "queue",
    "retry",
    "templates",
    "ejs"
  ],
  "bugs": {
    "url": "https://github.com/fwmakc/message-server/issues"
  },
  "homepage": "https://github.com/fwmakc/message-server#readme",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "ai-context": "node node_modules/api-server-toolkit/scripts/generate-service-context.js",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:auto": "npm run typeorm migration:generate -- -d ./src/config/typeorm.config.ts ./src/typeorm/migrations/auto",
    "migration:create": "npm run typeorm migration:create -- -n",
    "migration:run": "npm run typeorm migration:run -- -d ./src/config/typeorm.config.ts",
    "migration:revert": "npm run typeorm migration:revert",
    "migration:fake": "npm run migration:run -- --fake",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^2.3.7",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@sentry/nestjs": "^10.69.0",
    "api-server-toolkit": "github:fwmakc/api-server-toolkit#v2.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.10",
    "event-server": "github:fwmakc/event-server#v1.0.0",
    "helmet": "^8.3.0",
    "jwks-rsa": "^4.1.0",
    "morgan": "^1.10.1",
    "multer": "^1.4.4-lts.1",
    "nodemailer": "^6.9.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "redoc-express": "^2.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.28",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "^29.7.0",
    "prettier": "^2.3.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0"
  }
}
