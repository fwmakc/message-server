NODE_ENV=development
IP=localhost
PORT=3003
ROOT_PATH=.

# Auth server (for JWT verification via JWKS)
AUTH_SERVER_URL=http://localhost:3001

# Event bus (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=
SMTP_SENDER_NAME=
SMTP_SENDER_EMAIL=

# Documentation
SWAGGER_PREFIX=swagger
SWAGGER_PREFIX_REDOC=redoc
SWAGGER_TITLE=Message Server API
SWAGGER_DESCRIPTION=Email and notification service
SWAGGER_VERSION=1.0

# Infrastructure (optional)
SENTRY_DSN=
SENTRY_ENV=localhost
MORGAN_LOG_FORMAT=
