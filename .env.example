NODE_ENV=development
IP=localhost
PORT=3003
ROOT_PATH=.

# Auth server (for JWT verification via JWKS)
AUTH_SERVER_URL=http://localhost:3001

# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=message_server
DB_USER=root
DB_PASSWORD=
DB_SYNCHRONIZE=true

# Internal API key for service-to-service calls
INTERNAL_API_KEY=

# Event server (for subscriber registration)
EVENT_SERVER_URL=http://localhost:3005

# Webhook URL (this server's public URL, registered with event-server)
WEBHOOK_URL=http://localhost:3003/webhooks

# Route prefix (optional)
PREFIX=

# Queue worker
WORKER_INTERVAL_MS=5000
WORKER_MAX_INTERVAL_MS=25000
BATCH_SIZE=50
MAIL_MAX_ATTEMPTS=5
MAIL_RETRY_DELAY=5
MAIL_CLEANUP_INTERVAL=3600000
MAIL_CLEANUP_MAX_AGE_DAYS=30

# SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=
SMTP_SENDER_NAME=
SMTP_SENDER_EMAIL=

# Documentation
SWAGGER_PREFIX=swagger
SWAGGER_PREFIX_REDOC=redoc
SWAGGER_TITLE=Message Server API
SWAGGER_DESCRIPTION=Email and notification service
SWAGGER_VERSION=1.0

# Infrastructure (optional)
SENTRY_DSN=
SENTRY_ENV=localhost
MORGAN_LOG_FORMAT=
